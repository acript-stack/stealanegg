local function CleanupMovers(Root)
	if FlyConnection then
		FlyConnection:Disconnect()
		FlyConnection=nil
	end

	if BodyVelocity then
		pcall(function()
			BodyVelocity.Velocity=Vector3.zero
			BodyVelocity.MaxForce=Vector3.zero
		end)

		BodyVelocity:Destroy()
		BodyVelocity=nil
	end

	if BodyGyro then
		pcall(function()
			BodyGyro.MaxTorque=Vector3.zero
		end)

		BodyGyro:Destroy()
		BodyGyro=nil
	end

	if Root and Root.Parent then
		for _,Child in ipairs(Root:GetChildren()) do
			if Child.Name=="YokudoBV"
				or Child.Name=="YokudoBG"
			then
				pcall(function()
					Child:Destroy()
				end)
			end
		end
	end
end

local function MoveToPosition(
	Root,
	TargetPosition,
	StepDistance,
	Interval
)
	if not Root or not Root.Parent then
		return false
	end

	StepDistance=StepDistance or 100
	Interval=Interval or 0.1

	while Root.Parent do
		local CurrentPosition=Root.Position

		local Target=
			Vector3.new(
				TargetPosition.X,
				TargetPosition.Y+1.585,
				TargetPosition.Z
			)

		local Offset=Target-CurrentPosition
		local Distance=Offset.Magnitude

		if Distance<=0.5 then
			Root.CFrame=
				CFrame.new(
					Target,
					Target+Root.CFrame.LookVector
				)

			return true
		end

		local Direction=Offset.Unit

		local MoveDistance=
			math.min(
				StepDistance,
				Distance
			)

		local NewPosition=
			CurrentPosition+
			Direction*MoveDistance

		Root.CFrame=
			CFrame.new(
				NewPosition,
				NewPosition+Direction
			)

		task.wait(Interval)
	end

	return false
end

local function FlyToBestEgg(Root,Destination)
	if not Root or not Root.Parent then
		return false
	end

	CleanupMovers(Root)

	local Character=Root.Parent
	local Humanoid=Character:FindFirstChildOfClass("Humanoid")

	if Humanoid then
		Humanoid.PlatformStand=true
		Humanoid.AutoRotate=false
	end

	local FlyPosition=
		Vector3.new(
			Destination.X,
			Destination.Y+70,
			Destination.Z
		)

	BodyVelocity=Instance.new("BodyVelocity")
	BodyVelocity.Name="YokudoBV"
	BodyVelocity.MaxForce=Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)
	BodyVelocity.P=1250
	BodyVelocity.Velocity=Vector3.zero
	BodyVelocity.Parent=Root

	BodyGyro=Instance.new("BodyGyro")
	BodyGyro.Name="YokudoBG"
	BodyGyro.MaxTorque=Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)
	BodyGyro.P=3000
	BodyGyro.D=500
	BodyGyro.CFrame=Root.CFrame
	BodyGyro.Parent=Root

	local Speed=275
	local StartTime=tick()
	local Timeout=30
	local ArriveDistance=4.5
	local Finished=false

	FlyConnection=RunService.Heartbeat:Connect(function()
		if Finished then
			return
		end

		if not Root or not Root.Parent then
			Finished=true
			return
		end

		local CurrentPosition=Root.Position
		local Direction=FlyPosition-CurrentPosition
		local Distance=Direction.Magnitude

		if Distance<=ArriveDistance then
			Finished=true
			BodyVelocity.Velocity=Vector3.zero
			return
		end

		if tick()-StartTime>=Timeout then
			Finished=true
			return
		end

		BodyVelocity.Velocity=
			Direction.Unit*Speed

		local FlatDirection=
			Vector3.new(
				Direction.X,
				0,
				Direction.Z
			)

		if FlatDirection.Magnitude>3 then
			BodyGyro.CFrame=
				CFrame.new(
					CurrentPosition,
					CurrentPosition+FlatDirection.Unit
				)
		end
	end)

	while not Finished do
		if not Root or not Root.Parent then
			break
		end

		task.wait()
	end

	if BodyVelocity then
		BodyVelocity.Velocity=Vector3.zero
	end

	if Humanoid then
		Humanoid.PlatformStand=false
		Humanoid.AutoRotate=true
	end

	CleanupMovers(Root)

	return Root
		and Root.Parent
		and (Root.Position-FlyPosition).Magnitude<=5
end

local function ProcessEgg()
	local Root=
		GetRoot()

	local BestEgg=
		GetBestEgg()

	if not BestEgg or not IsValidEgg(BestEgg) then
		return
	end

	local BestCFrame=
		GetModelCFrame(
			BestEgg.Model
		)

	if not BestCFrame then
		return
	end

	local BestPosition=
		BestCFrame.Position

	local StartPosition=
		Vector3.new(
			541,
			71,
			-365
		)

	local ReachedStart=
		MoveToPosition(
			Root,
			StartPosition,
			350,
			0.045
		)

	task.wait(0.1)

	local ReachedEgg=
	FlyToBestEgg(
		Root,
		BestPosition
	)

if not ReachedEgg then
	return
end

local ExactBestCFrame=
	GetModelCFrame(
		BestEgg.Model
	)

if ExactBestCFrame then
	Root.CFrame=ExactBestCFrame
	Root.AssemblyLinearVelocity=Vector3.zero
	Root.AssemblyAngularVelocity=Vector3.zero
	task.wait(0.05)
end

pcall(function()
	ForestStrike:FireServer()
end)

task.wait(1)

	pcall(function()
		AskFieldEggCarry:InvokeServer({
			Uid=BestEgg.UID
		})
	end)

	pcall(function()
		FieldEggCarry:FireServer({
			Uid=BestEgg.UID
		})
	end)

	task.wait(0.15)

	local FirstDestination=
		Vector3.new(
			745,
			71,
			-413
		)

	local ReachedFirstDestination=
		MoveToPosition(
			Root,
			FirstDestination,
			400,
			0.055
		)

	if not ReachedFirstDestination then
		return
	end

	task.wait(0.5)

	pcall(function()
		AskFieldEggDrop:InvokeServer({
			Reason="PlayerRequest"
		})
	end)

	task.wait(0.2)

	pcall(function()
		AskFieldEggCarry:InvokeServer({
			Uid=BestEgg.UID
		})
	end)

	pcall(function()
		FieldEggCarry:FireServer({
			Uid=BestEgg.UID
		})
	end)

	task.wait(0.45)

	local FinalDestination=
		Vector3.new(
			506,
			71,
			-419
		)

	Root.CFrame=
		CFrame.new(
			FinalDestination
		)

	Root.AssemblyLinearVelocity=Vector3.zero
	Root.AssemblyAngularVelocity=Vector3.zero
end

