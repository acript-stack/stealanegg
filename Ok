local function FormatMoney(Value)
	local Number=tonumber(Value) or 0
	local Abs=math.abs(Number)

	local function Short(N)
		return string.format("%.2f",N)
			:gsub("(%..-)0+$","%1")
			:gsub("%.$","")
	end

	if Abs>=1e15 then
		return Short(Number/1e15).."Q"
	elseif Abs>=1e12 then
		return Short(Number/1e12).."T"
	elseif Abs>=1e9 then
		return Short(Number/1e9).."B"
	elseif Abs>=1e6 then
		return Short(Number/1e6).."M"
	elseif Abs>=1e3 then
		return Short(Number/1e3).."K"
	end

	return tostring(math.floor(Number+0.5))
end

local function GetRarityConfig(Name)
	local Key=string.lower(tostring(Name or "")):gsub("%s+","")

	for RarityKey,RarityData in pairs(Rarity.Rarities or {}) do
		local Key1=string.lower(tostring(RarityKey)):gsub("%s+","")
		local Key2=string.lower(
			tostring(
				type(RarityData)=="table" and RarityData.DisplayName or ""
			)
		):gsub("%s+","")

		if Key1==Key or Key2==Key then
			return RarityData
		end
	end

	return nil
end

local function GetRarityColor(Name)
	local Data=GetRarityConfig(Name)

	if Data then
		local Color=Data.Color

		if typeof(Color)=="ColorSequence" then
			return Color.Keypoints[1].Value
		end

		if typeof(Color)=="Color3" then
			return Color
		end
	end

	return Color3.fromRGB(170,190,178)
end

local CurrentPreviewCategory=nil

local function ClearPreview()
	for _,Object in ipairs(Preview:GetChildren()) do
		if not Object:IsA("UICorner") then
			Object:Destroy()
		end
	end
end

local function UpdatePreview(Category)
	if not Category then
		ClearPreview()
		CurrentPreviewCategory=nil
		return
	end

	if CurrentPreviewCategory==Category and Preview:FindFirstChild("AssetViewport") then
		return
	end

	CurrentPreviewCategory=Category
	ClearPreview()

	local OK,Viewport=pcall(function()
		return AssetViewport.Mount(Preview)
	end)

	if not OK or not Viewport then
		return
	end

	Viewport.Name="AssetViewport"
	Viewport.Size=UDim2.fromScale(1,1)
	Viewport.Position=UDim2.fromScale(0.5,0.5)
	Viewport.AnchorPoint=Vector2.new(0.5,0.5)
	Viewport.BackgroundTransparency=1
	Viewport.Parent=Preview

	pcall(function()
		AssetViewport.ShowAsset(Category,Viewport,true)
	end)
end

