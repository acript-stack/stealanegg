local function RefreshEgg(model)
	if not model or not model.Parent then
		return
	end

	local data=GetEggData(model)

	if data then
		Eggs[model]=data
	else
		RemoveEgg(model)
	end
end

local function GetBestEgg()
	local best
	local bestRate=-math.huge

	for model,data in pairs(Eggs) do
		if model.Parent and not IsIgnored(model) then
			local configObject=Configs:FindFirstChild(data.Category)
			local config=configObject and ConfigCache[configObject]

			if config and IsSelectedRarity(data.Category) then
				local scale=model:GetAttribute("AssetScale") or 1
				local mutations=model:GetAttribute("Mutations") or {}

				data.EarningRate=CalculateRate(
					config.EarningRate,
					scale,
					mutations
				)

				if data.EarningRate>bestRate then
					best=data
					bestRate=data.EarningRate
				end
			end
		else
			RemoveEgg(model)
		end
	end

	return best
end

local function IsValidEgg(data)
	if not data or not data.Model or not data.Model.Parent then
		return false
	end

	if IsIgnored(data.Model) then
		return false
	end

	if not IsRandomUID(data.Model.Name) then
		return false
	end

	return Eggs[data.Model]~=nil
		and data.UID==data.Model.Name
end

local function GetModelCFrame(model)
	if not model then
		return
	end

	if model:IsA("BasePart") then
		return model.CFrame
	end

	if model:IsA("Model") then
		if model.PrimaryPart then
			return model.PrimaryPart.CFrame
		end

		local ok,cf=pcall(function()
			return model:GetPivot()
		end)

		if ok then
			return cf
		end
	end
end

