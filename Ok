local function GetEggRarity(Category)
	local ConfigObject=Configs:FindFirstChild(Category)

	if not ConfigObject then
		return nil
	end

	local AssetData=ConfigCache[ConfigObject]

	if not AssetData then
		return nil
	end

	local RarityModule

	pcall(function()
		RarityModule=require(
			RS
				:WaitForChild("Data")
				:WaitForChild("Rarity")
		)
	end)

	if not RarityModule then
		return nil
	end

	local Assets=nil

	pcall(function()
		local Data=RS:FindFirstChild("Data")
		local AssetModule=Data and Data:FindFirstChild("Assets")

		if AssetModule and AssetModule:IsA("ModuleScript") then
			Assets=require(AssetModule)
		end
	end)

	if Assets and Assets.Directory then
		local DirectoryData=Assets.Directory[Category]

		if DirectoryData then
			return DirectoryData.Rarity
		end
	end

	return nil
end

local function IsSelectedRarity(Category)
	local RarityName=GetEggRarity(Category)

	if not RarityName then
		return false
	end

	local Key=tostring(RarityName):lower():gsub("%s+","")

	for Name,Enabled in pairs(SelectedRarities) do
		if Enabled and Name:lower()==Key then
			return true
		end
	end

	return false
end

local function CalculateRate(base,scale,mutations)
	base=tonumber(base) or 0
	scale=tonumber(scale) or 1

	local payout

	if scale<=5 then
		payout=scale^1.85
	else
		payout=(scale/5)^1.2*19.637875755794113
	end

	local multiplier=1

	if type(mutations)=="table" and #mutations>0 and MutationsModule then
		local ok,result=pcall(function()
			return MutationsModule.EarningsFor(mutations)
		end)

		if ok and type(result)=="number" then
			multiplier=result
		end
	end

	return math.round(base*payout*multiplier)
end

local function IsRandomUID(name)
	return type(name)=="string"
		and #name==32
		and name:match("^[%da-f]+$")~=nil
end

local function GetEggData(model)
	if not model:IsA("Model") or IsIgnored(model) then
		return
	end

	if not IsRandomUID(model.Name) then
		return
	end

	local category=FindAssetCategory(model)

	if not category then
		return
	end

	local configObject=Configs:FindFirstChild(category)
	local config=configObject and ConfigCache[configObject]

	if not config then
		return
	end

	local scale=model:GetAttribute("AssetScale") or 1
	local mutations=model:GetAttribute("Mutations") or {}

	return {
		Model=model,
		UID=model.Name,
		Category=category,
		DisplayName=config.DisplayName,
		EarningRate=CalculateRate(
			config.EarningRate,
			scale,
			mutations
		)
	}
end

local function RemoveEgg(model)
	Eggs[model]=nil
	CategoryCache[model]=nil

	local connection=Connections[model]

	if connection then
		connection:Disconnect()
		Connections[model]=nil
	end
end

local function TrackEgg(model)
	if not model:IsA("Model") or not model.Parent then
		return
	end

	local data=GetEggData(model)

	if not data then
		return
	end

	Eggs[model]=data

	if not Connections[model] then
		Connections[model]=model.AncestryChanged:Connect(function()
			if not model:IsDescendantOf(Workspace) or IsIgnored(model) then
				RemoveEgg(model)
				return
			end

			local updated=GetEggData(model)

			if updated then
				Eggs[model]=updated
			else
				RemoveEgg(model)
			end
		end)
	end
end

for _,obj in ipairs(Workspace:GetDescendants()) do
	if obj:IsA("Model") then
		TrackEgg(obj)
	end
end

